---
---
<section class="hero">
  <div class="name-row">
    <img src="/avatar.svg" alt="Bằng Nguyễn" class="avatar" />
    <span class="name">Bằng Nguyễn</span>
  </div>
  <p class="bio">
    Background in <strong>mobile, desktop, and web</strong>. Currently learning
    <strong>AI</strong> and applying <strong>Claude</strong> to developer tooling
    and automation.
  </p>
  <nav class="social">
    <a href="https://github.com/Bangkts" target="_blank" rel="noopener">GitHub</a>
    <a href="#" target="_blank" rel="noopener">YouTube</a>
    <a href="#" target="_blank" rel="noopener">TikTok</a>
    <a href="#" target="_blank" rel="noopener">Facebook</a>
    <a href="mailto:ngbangkts@gmail.com">Email</a>
    <!-- Nút Chủ đề: chỉ hiện trên mobile, mở popup -->
    <button id="open-topics-btn" class="topics-btn">Chủ đề</button>
  </nav>
</section>

<style>
  .hero { padding: 1.1rem 0 1rem; }

  .name-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .avatar {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e5e5e5;
    flex-shrink: 0;
  }

  .name {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .bio {
    font-size: 1.0625rem;
    color: #222;
    line-height: 1.65;
    margin-bottom: 0.8rem;
    max-width: 520px;
  }

  .bio strong { color: var(--accent); font-weight: 400; }

  .social {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .social a {
    font-size: 0.9375rem;
    color: var(--accent);
    transition: opacity 0.15s;
  }

  .social a:hover { opacity: 0.6; }

  /* Nút Chủ đề — ẩn trên desktop, hiện trên mobile */
  .topics-btn {
    display: none;
    font-size: 0.9375rem;
    color: var(--accent);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.15s;
  }

  .topics-btn:hover { opacity: 0.6; }

  @media (max-width: 768px) {
    .name { font-size: 1.5rem; }
    .bio { font-size: 0.9375rem; }
    .avatar { width: 52px; height: 52px; }
    .topics-btn { display: inline; }
  }
</style>
