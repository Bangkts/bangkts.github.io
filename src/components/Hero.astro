<section class="hero">
  <div class="hero-inner">
    <div class="avatar-wrap">
      <img src="/avatar.svg" alt="Bằng Nguyễn" class="avatar" />
    </div>
    <div class="hero-info">
      <h1 class="name">Bằng Nguyễn</h1>
      <p class="bio">
        Background in <strong>mobile, desktop, and web</strong>. Currently learning
        <strong>AI</strong> and applying <strong>Claude</strong> to developer tooling
        and automation.
      </p>
      <nav class="social-links">
        <a href="https://github.com/Bangkts" target="_blank" rel="noopener">GitHub</a>
        <a href="#" target="_blank" rel="noopener">YouTube</a>
        <a href="#" target="_blank" rel="noopener">TikTok</a>
        <a href="#" target="_blank" rel="noopener">Facebook</a>
        <a href="mailto:ngbangkts@gmail.com">Email</a>
      </nav>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 2rem 2.5rem 1.5rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .hero-inner {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 900px;
  }

  .avatar-wrap {
    flex-shrink: 0;
  }

  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e5e7eb;
  }

  .hero-info {
    flex: 1;
  }

  .name {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: #111827;
  }

  .bio {
    font-size: 0.95rem;
    color: #374151;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .bio strong {
    color: #e85d04;
    font-weight: 600;
  }

  .social-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .social-links a {
    font-size: 0.875rem;
    color: #e85d04;
    font-weight: 500;
    transition: opacity 0.15s;
  }

  .social-links a:hover {
    opacity: 0.7;
  }
</style>
