<section class="hero">
  <div class="name-row">
    <img src="/avatar.svg" alt="Bằng Nguyễn" class="avatar" />
    <span class="name">Bằng Nguyễn</span>
  </div>
  <p class="bio">
    Background in <strong>mobile, desktop, and web</strong>. Currently learning
    <strong>AI</strong> and applying <strong>Claude</strong> to developer tooling
    and automation.
  </p>
  <nav class="social">
    <a href="https://github.com/Bangkts" target="_blank" rel="noopener">GitHub</a>
    <a href="#" target="_blank" rel="noopener">YouTube</a>
    <a href="#" target="_blank" rel="noopener">TikTok</a>
    <a href="#" target="_blank" rel="noopener">Facebook</a>
    <a href="mailto:ngbangkts@gmail.com">Email</a>
  </nav>
</section>

<style>
  .hero { padding: 1.25rem 0 1rem; }

  .name-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e8e8e8;
    flex-shrink: 0;
  }

  .name {
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .bio {
    font-size: 0.92rem;
    color: #222;
    line-height: 1.65;
    margin-bottom: 0.85rem;
  }

  .bio strong { color: var(--accent); font-weight: 500; }

  .social { display: flex; gap: 1.1rem; }

  .social a {
    font-size: 0.85rem;
    color: var(--accent);
    transition: opacity 0.15s;
  }

  .social a:hover { opacity: 0.6; }
</style>
