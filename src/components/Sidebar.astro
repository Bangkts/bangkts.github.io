---
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props { currentSlug?: string; }
const { currentSlug } = Astro.props;

const REPO = 'Bangkts/bangkts.github.io';
const BASE  = `https://github.com/${REPO}`;

type Article = CollectionEntry<'articles'>;
type Group   = { catOrder: number; folder: string; articles: Article[] };

const allArticles = await getCollection('articles');

const grouped: Record<string, Group> = {};
for (const article of allArticles) {
  const cat    = article.data.category;
  const folder = article.id.split('/')[0];
  if (!grouped[cat]) {
    grouped[cat] = { catOrder: article.data.categoryOrder ?? 99, folder, articles: [] };
  }
  grouped[cat].articles.push(article);
}

for (const cat of Object.values(grouped)) {
  cat.articles.sort((a: Article, b: Article) => (a.data.order ?? 99) - (b.data.order ?? 99));
}

const sortedCategories: [string, Group][] = Object.entries(grouped)
  .sort(([, a], [, b]) => a.catOrder - b.catOrder);

// URL thêm section mới với template frontmatter điền sẵn
function addSectionUrl() {
  const template = [
    '---',
    'title: "Tiêu đề bài viết đầu tiên"',
    'category: "Tên Section Mới"',
    'categoryOrder: 10',
    'order: 1',
    '---',
    '',
    'Nội dung bài viết ở đây...',
  ].join('\n');

  const params = new URLSearchParams({
    filename: 'ten-section-moi/ten-bai-viet.md',
    value: template,
  });
  return `${BASE}/new/main/src/content/articles?${params.toString()}`;
}
---

<nav class="sidebar">
  {sortedCategories.map(([category, { folder, articles, catOrder }]) => {
    return (
      <div class="group">
        <p class="cat-title">{category}</p>
        <ul>
          {articles.map((article: Article) => {
            const slug      = article.id.replace(/\.md$/, '');
            const isActive  = currentSlug === article.id;
            const filePath  = `src/content/articles/${article.id}.md`;
            return (
              <li class="article-row">
                <a href={`/articles/${slug}`} class:list={['link', { active: isActive }]}>
                  {article.data.title}
                </a>
                <button
                  class="btn-delete"
                  title="Xoá bài viết này"
                  data-file={filePath}
                  data-title={article.data.title}
                  data-is-current={isActive ? "true" : "false"}
                >✕</button>
              </li>
            );
          })}
        </ul>

        <a href={`/admin?category=${encodeURIComponent(category)}|${folder}|${catOrder}`} class="btn-add-topic">
          + Thêm chủ đề
        </a>
      </div>
    );
  })}

  <a href={addSectionUrl()} target="_blank" rel="noopener" class="btn-add-section">
    + Thêm Section
  </a>
</nav>

<style>
  .sidebar { width: 100%; }

  .group { margin-bottom: 1.25rem; }

  .cat-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
    letter-spacing: 0.005em;
  }

  ul { list-style: none; }

  .article-row {
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .link {
    flex: 1;
    display: block;
    padding: 0.2rem 0;
    font-size: 0.75rem;   /* 14px → 12px */
    color: var(--text-muted);
    line-height: 1.45;
    transition: color 0.1s;
    min-width: 0;
  }

  .link:hover  { color: var(--text); }
  .link.active { color: var(--text); font-weight: 500; }

  .btn-delete {
    opacity: 0;
    flex-shrink: 0;
    font-size: 0.65rem;
    color: #bbb;
    padding: 0.3rem 0.2rem;
    line-height: 1;
    transition: opacity 0.15s, color 0.15s;
    cursor: pointer;
    background: none;
    border: none;
    font-family: inherit;
  }

  .article-row:hover .btn-delete { opacity: 1; }
  .btn-delete:hover { color: #e53e3e; }

  .btn-add-topic {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: #bbb;
    transition: color 0.15s;
    padding: 0.15rem 0;
  }

  .btn-add-topic:hover { color: var(--accent); }

  .btn-add-section {
    display: block;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed #e0e0e0;
    font-size: 0.75rem;
    color: #bbb;
    transition: color 0.15s;
  }

  .btn-add-section:hover { color: var(--accent); }
</style>
