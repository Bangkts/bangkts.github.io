---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
}
const { currentSlug } = Astro.props;

const allArticles = await getCollection('articles');
allArticles.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const grouped: Record<string, typeof allArticles> = {};
for (const article of allArticles) {
  const cat = article.data.category;
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(article);
}
---

<nav class="sidebar">
  {Object.entries(grouped).map(([category, articles]) => (
    <div class="category">
      <h3 class="category-title">{category}</h3>
      <ul>
        {articles.map((article) => {
          const slug = article.id.replace(/\.md$/, '');
          const isActive = currentSlug === article.id;
          return (
            <li>
              <a
                href={`/articles/${slug}`}
                class:list={['article-link', { active: isActive }]}
              >
                {article.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    padding: 1.5rem 1.25rem 2rem;
    overflow-y: auto;
    position: sticky;
    top: 0;
    height: calc(100vh - 200px);
    border-right: 1px solid var(--border);
  }

  .category {
    margin-bottom: 1.75rem;
  }

  .category-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  ul { list-style: none; }

  .article-link {
    display: block;
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.45;
    transition: color 0.12s;
  }

  .article-link:hover {
    color: var(--text);
  }

  .article-link.active {
    color: var(--text);
    font-weight: 600;
  }
</style>
