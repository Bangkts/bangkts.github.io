---
import { getCollection } from 'astro:content';

interface Props { currentSlug?: string; }
const { currentSlug } = Astro.props;

const allArticles = await getCollection('articles');

// Group by category
const grouped: Record<string, { catOrder: number; articles: typeof allArticles }> = {};
for (const article of allArticles) {
  const cat = article.data.category;
  if (!grouped[cat]) {
    grouped[cat] = { catOrder: article.data.categoryOrder ?? 99, articles: [] };
  }
  grouped[cat].articles.push(article);
}

// Sort articles within each category by order
for (const cat of Object.values(grouped)) {
  cat.articles.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}

// Sort categories by categoryOrder
const sortedCategories = Object.entries(grouped).sort((a, b) => a[1].catOrder - b[1].catOrder);
---

<nav class="sidebar">
  {sortedCategories.map(([category, { articles }]) => (
    <div class="group">
      <p class="cat-title">{category}</p>
      <ul>
        {articles.map((article) => {
          const slug = article.id.replace(/\.md$/, '');
          const isActive = currentSlug === article.id;
          return (
            <li>
              <a href={`/articles/${slug}`} class:list={['link', { active: isActive }]}>
                {article.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    padding: 1.25rem 1.5rem 2rem 0;
    position: sticky;
    top: 0;
    max-height: 100vh;
    overflow-y: auto;
  }

  .group { margin-bottom: 1.5rem; }

  .cat-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  ul { list-style: none; }

  .link {
    display: block;
    padding: 0.2rem 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
    transition: color 0.1s;
  }

  .link:hover { color: var(--text); }
  .link.active { color: var(--text); font-weight: 500; }
</style>
