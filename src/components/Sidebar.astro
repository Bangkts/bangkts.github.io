---
import { getCollection } from 'astro:content';

interface Props { currentSlug?: string; }
const { currentSlug } = Astro.props;

const allArticles = await getCollection('articles');

const grouped: Record<string, { catOrder: number; articles: typeof allArticles }> = {};
for (const article of allArticles) {
  const cat = article.data.category;
  if (!grouped[cat]) {
    grouped[cat] = { catOrder: article.data.categoryOrder ?? 99, articles: [] };
  }
  grouped[cat].articles.push(article);
}

for (const cat of Object.values(grouped)) {
  cat.articles.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}

const sortedCategories = Object.entries(grouped).sort((a, b) => a[1].catOrder - b[1].catOrder);
---

<nav class="sidebar">
  {sortedCategories.map(([category, { articles }]) => (
    <div class="group">
      <p class="cat-title">{category}</p>
      <ul>
        {articles.map((article) => {
          const slug = article.id.replace(/\.md$/, '');
          const isActive = currentSlug === article.id;
          return (
            <li>
              <a href={`/articles/${slug}`} class:list={['link', { active: isActive }]}>
                {article.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar { width: 100%; }

  .group { margin-bottom: 1.25rem; }

  .cat-title {
    font-size: 0.8125rem;   /* 13px */
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.35rem;
    letter-spacing: 0.005em;
  }

  ul { list-style: none; }

  .link {
    display: block;
    padding: 0.18rem 0;
    font-size: 0.75rem;     /* 12px */
    color: var(--text-muted);
    line-height: 1.45;
    transition: color 0.1s;
  }

  .link:hover { color: var(--text); }

  .link.active {
    color: var(--text);
    font-weight: 500;
  }
</style>
