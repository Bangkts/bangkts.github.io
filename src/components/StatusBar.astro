---
interface Props {
  text?: string;
}
const { text = 'Exploring AI · applying Claude to dev tools' } = Astro.props;
---
<div class="status-wrap">
  <div class="status-bar">
    <span class="dot"></span>
    <span>{text}</span>
  </div>
</div>

<style>
  .status-wrap {
    display: flex;
    justify-content: center;
    padding: 1.25rem 1rem 0;
  }

  .status-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.8rem;
    color: #555;
    background: #f3f0eb;
    border: 1px solid #ddd9d3;
    border-radius: 999px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }
</style>
