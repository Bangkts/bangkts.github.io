---
interface Props { text?: string; }
const { text = 'Exploring AI · applying Claude to dev tools' } = Astro.props;
---
<div class="sb-wrap">
  <span class="sb">
    <span class="dot"></span>{text}
  </span>
</div>

<style>
  .sb-wrap {
    display: flex;
    justify-content: center;
    padding: 1.25rem 0 0;
  }
  .sb {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: #555;
    background: #f5f5f5;
    border: 1px solid #ddd;
    border-radius: 999px;
    padding: 0.28rem 0.9rem;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    flex-shrink: 0;
  }
</style>
