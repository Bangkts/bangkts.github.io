---
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Thêm bài viết</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --accent: #d4674a; --border: #e8e8e8; --font: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif; }
    body { font-family: var(--font); background: #fafafa; color: #1a1a1a; font-size: 14px; padding: 2rem 1rem; }
    .wrap { max-width: 560px; margin: 0 auto; }
    h1 { font-size: 1.25rem; font-weight: 700; margin-bottom: .2rem; }
    .sub { font-size: .8rem; color: #888; margin-bottom: 2rem; }
    .card { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1rem; }
    .step { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #aaa; margin-bottom: 1rem; }
    .field { margin-bottom: .9rem; }
    .field:last-child { margin-bottom: 0; }
    label { display: block; font-size: .8125rem; font-weight: 600; color: #444; margin-bottom: .3rem; }
    input[type=text], input[type=url], input[type=password], input[type=number], select {
      width: 100%; padding: .5rem .75rem; border: 1px solid var(--border); border-radius: 6px;
      font-size: .875rem; font-family: var(--font); background: #fff; outline: none; transition: border-color .15s;
    }
    input:focus, select:focus { border-color: var(--accent); }
    .row { display: flex; gap: .75rem; }
    .row .field { flex: 1; }
    .btn {
      width: 100%; padding: .65rem 1rem; border-radius: 8px; font-size: .9375rem;
      font-weight: 700; font-family: var(--font); cursor: pointer; border: none;
      background: var(--accent); color: #fff; transition: opacity .15s;
    }
    .btn:hover { opacity: .88; }
    .btn:disabled { opacity: .45; cursor: not-allowed; }
    .msg { font-size: .8125rem; text-align: center; padding: .6rem; border-radius: 6px; margin-top: .75rem; display: none; }
    .msg.show { display: block; }
    .msg.ok   { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
    .msg.err  { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .msg.spin { background: #fff7ed; color: var(--accent); border: 1px solid #fed7aa; }
    .hint { font-size: .75rem; color: #aaa; margin-top: .3rem; }
    details { margin-top: .5rem; }
    summary { cursor: pointer; font-size: .8rem; color: #999; user-select: none; padding: .3rem 0; }
    summary:hover { color: #444; }
    details[open] summary { margin-bottom: .75rem; }
    .divider { text-align: center; color: #ccc; font-size: .8rem; margin: 1rem 0; position: relative; }
    .divider::before, .divider::after {
      content: ''; position: absolute; top: 50%; width: 42%; height: 1px; background: var(--border);
    }
    .divider::before { left: 0; }
    .divider::after { right: 0; }
    @media(max-width:480px){ .row { flex-direction: column; } }
  </style>
</head>
<body>
<div class="wrap">
  <h1>✍️ Thêm bài viết</h1>
  <p class="sub">Paste URL → GitHub Actions tự fetch, tạo file, deploy</p>

  <!-- Auto từ URL -->
  <div class="card">
    <p class="step">🤖 Tự động từ URL</p>

    <div class="field">
      <label>URL bài viết *</label>
      <input type="url" id="url" placeholder="https://blog.bytebytego.com/p/..." />
    </div>

    <div class="row">
      <div class="field">
        <label>Category</label>
        <select id="category">
          <option value="AI Notes|ai-notes|3">AI Notes</option>
          <option value="System Design|system-design|1">System Design</option>
          <option value="Art of Programming Computer|programming|2">Programming</option>
        </select>
      </div>
      <div class="field">
        <label>Tên nguồn</label>
        <input type="text" id="sourceLabel" value="ByteByteGo" />
      </div>
    </div>

    <button class="btn" id="autoBtn">🚀 Thêm bài tự động</button>
    <div class="msg" id="autoMsg"></div>
  </div>

  <div class="divider">hoặc viết tay</div>

  <!-- Viết tay -->
  <div class="card">
    <p class="step">✏️ Viết nội dung thủ công</p>
    <p style="font-size:.8125rem;color:#666;margin-bottom:1rem">
      Dùng trang <a href="/admin/manual" style="color:var(--accent)">Admin nâng cao</a>
      để viết bài, thêm ảnh và lưu lên GitHub thủ công.
    </p>
    <a href="https://bangkts.github.io/admin/manual" style="
      display:block;text-align:center;padding:.55rem 1rem;border-radius:8px;
      border:1.5px solid var(--border);font-size:.875rem;font-weight:600;color:#555;
      transition:border-color .15s;
    " onmouseover="this.style.borderColor='var(--accent)'"
       onmouseout="this.style.borderColor='var(--border)'">
      Mở Admin nâng cao →
    </a>
  </div>

  <!-- GitHub Token -->
  <details>
    <summary>⚙️ GitHub Token</summary>
    <div class="card">
      <div class="field">
        <label>Personal Access Token (quyền repo + workflow)</label>
        <input type="password" id="ghToken" placeholder="ghp_..." />
        <p class="hint">Lấy tại github.com/settings/tokens/new — tick repo + workflow — 1 year</p>
      </div>
      <button class="btn" id="saveToken" style="width:auto;padding:.4rem 1rem;font-size:.8125rem;font-weight:600">
        💾 Lưu token
      </button>
      <div class="msg" id="tokenMsg"></div>
    </div>
  </details>
</div>

<script>
// @ts-nocheck
const REPO = 'Bangkts/bangkts.github.io';
const $ = (id) => document.getElementById(id);

// Đọc category từ URL param (vd: ?category=AI Notes|ai-notes|3)
const params = new URLSearchParams(location.search);
const catParam = params.get('category');
if (catParam) {
  const sel = $('category');
  for (const opt of sel.options) {
    if (opt.value === catParam) { opt.selected = true; break; }
  }
}

// Load token
$('ghToken').value = localStorage.getItem('ghToken') || '';
$('saveToken').onclick = () => {
  localStorage.setItem('ghToken', $('ghToken').value.trim());
  showMsg('tokenMsg', '✓ Đã lưu token', 'ok');
};

// Nút thêm bài tự động
$('autoBtn').onclick = async () => {
  const token = $('ghToken').value.trim() || localStorage.getItem('ghToken');
  const url   = $('url').value.trim();
  const [category, folder, catOrder] = $('category').value.split('|');
  const sourceLabel = $('sourceLabel').value.trim();

  if (!token) {
    alert('Vui lòng nhập GitHub Token trong ⚙️ GitHub Token bên dưới');
    return;
  }
  if (!url) {
    alert('Vui lòng nhập URL bài viết');
    return;
  }

  showMsg('autoMsg', '⏳ Đang gửi yêu cầu đến GitHub Actions...', 'spin');
  $('autoBtn').disabled = true;

  try {
    const res = await fetch(
      `https://api.github.com/repos/${REPO}/actions/workflows/add-article.yml/dispatches`,
      {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${token}`,
          'Content-Type': 'application/json',
          Accept: 'application/vnd.github+json',
        },
        body: JSON.stringify({
          ref: 'main',
          inputs: {
            url,
            source_label: sourceLabel,
            category,
            category_order: catOrder,
            output_folder: folder,
          },
        }),
      }
    );

    if (res.status === 204) {
      showMsg('autoMsg',
        '✅ Đã gửi thành công! GitHub Actions đang xử lý...<br>' +
        'Bài viết sẽ xuất hiện trên trang sau <strong>~3 phút</strong>.<br>' +
        `<a href="https://github.com/${REPO}/actions" target="_blank" style="color:var(--accent)">` +
        'Theo dõi tiến trình →</a>',
        'ok');
      $('url').value = '';
    } else {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.message || `HTTP ${res.status}`);
    }
  } catch (e) {
    showMsg('autoMsg', `✗ Lỗi: ${e.message}`, 'err');
  }

  $('autoBtn').disabled = false;
};

function showMsg(id, html, cls) {
  const el = $(id);
  el.innerHTML   = html;
  el.className   = `msg ${cls} show`;
}
</script>
</body>
</html>
