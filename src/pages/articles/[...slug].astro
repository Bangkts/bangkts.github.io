---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBar from '../../components/StatusBar.astro';
import Hero from '../../components/Hero.astro';
import Sidebar from '../../components/Sidebar.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const REPO = 'Bangkts/bangkts.github.io';
const editUrl = `https://github.com/${REPO}/edit/main/src/content/articles/${entry.id}.md`;
---

<BaseLayout title={`${entry.data.title} — Bằng Nguyễn`}>
  <div class="page">

    <!--
      Cột phải / hàng 1: status bar + hero
      (cột trái / hàng 1 để trống — sidebar chưa xuất hiện ở đây)
    -->
    <div class="hero-area">
      <StatusBar />
      <Hero />
    </div>

    <!--
      Hàng 2: hai cột song song
      Cột trái: sidebar | Cột phải: nội dung bài viết
    -->
    <aside class="sidebar-area">
      <Sidebar currentSlug={entry.id} />
    </aside>

    <main class="article-area">
      <div class="title-row">
        <h1 class="article-title">{entry.data.title}</h1>
        <a href={editUrl} target="_blank" rel="noopener" class="edit-btn" title="Chỉnh sửa bài viết">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Edit
        </a>
      </div>
      <div class="article-body">
        <Content />
      </div>
    </main>

  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: 195px 1fr;
    grid-template-rows: auto 1fr;
    /*
      hero-area   → cột 2, hàng 1
      sidebar     → cột 1, hàng 2
      article     → cột 2, hàng 2
      (cột 1, hàng 1 để trống)
    */
    max-width: 960px;
    margin: 0 auto;
    min-height: 100vh;
  }

  /* Cột phải – hàng 1: status bar + hero */
  .hero-area {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
    padding: 0 2.5rem 0.5rem;
  }

  /* Cột trái – hàng 2: sidebar */
  .sidebar-area {
    grid-column: 1 / 2;
    grid-row: 2 / 3;
    border-right: 1px solid var(--border);
    padding: 1.5rem 1rem 3rem 1.25rem;
    align-self: start;
    position: sticky;
    top: 0;
  }

  /* Cột phải – hàng 2: bài viết */
  .article-area {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    border-top: 1px solid var(--border);
    padding: 1.5rem 2.5rem 3rem;
    max-width: 680px;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .article-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    flex: 1;
  }

  .edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: #999;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 0.25rem 0.6rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s, border-color 0.15s;
    margin-top: 0.1rem;
  }

  .edit-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
