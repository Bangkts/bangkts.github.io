---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBar from '../../components/StatusBar.astro';
import Hero from '../../components/Hero.astro';
import Sidebar from '../../components/Sidebar.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const REPO = 'Bangkts/bangkts.github.io';
const editUrl = `https://github.com/${REPO}/edit/main/src/content/articles/${entry.id}.md`;
---

<BaseLayout title={`${entry.data.title} — Bằng Nguyễn`}>
  <div class="page">

    <div class="hero-area">
      <StatusBar />
      <Hero />
    </div>

    <aside class="sidebar-area">
      <Sidebar currentSlug={entry.id} />
    </aside>

    <main class="article-area">
      <div class="title-row">
        <h1 class="article-title">{entry.data.title}</h1>
        <a href={editUrl} target="_blank" rel="noopener" class="edit-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Edit
        </a>
      </div>
      <!-- Nút link bài gốc (chỉ hiện khi có source) -->
      {entry.data.source && (
        <a
          href={entry.data.source}
          target="_blank"
          rel="noopener noreferrer"
          class="source-btn"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          Đọc bài gốc{entry.data.sourceLabel ? ` trên ${entry.data.sourceLabel}` : ''}
        </a>
      )}

      <div class="article-body">
        <Content />
      </div>
    </main>

  </div>

  <!-- Popup chủ đề (dùng dialog — tự đóng khi bấm Escape) -->
  <dialog id="topics-dialog">
    <div class="dialog-header">
      <span class="dialog-title">Chủ đề</span>
      <button id="close-topics-btn" class="dialog-close" aria-label="Đóng">✕</button>
    </div>
    <div class="dialog-body">
      <Sidebar currentSlug={entry.id} />
    </div>
  </dialog>

<script>
  window.scrollTo({ top: 0, behavior: 'instant' });

  const dialog = document.getElementById('topics-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('open-topics-btn');
  const closeBtn = document.getElementById('close-topics-btn');

  openBtn?.addEventListener('click', () => dialog?.showModal());
  closeBtn?.addEventListener('click', () => dialog?.close());

  // Đóng khi click vùng backdrop
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // KHÔNG gọi dialog.close() khi click link —
  // trang static reload toàn bộ, dialog tự biến mất
</script>
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: 195px 1fr;
    grid-template-rows: auto 1fr;
    max-width: 960px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .hero-area {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
    padding: 0 2.5rem 0.5rem;
  }

  .sidebar-area {
    grid-column: 1 / 2;
    grid-row: 2 / 3;
    border-right: 1px solid var(--border);
    padding: 1.5rem 1rem 3rem 1.25rem;
    align-self: start;
    position: sticky;
    top: 0;
  }

  .article-area {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    border-top: 1px solid var(--border);
    padding: 1.5rem 2.5rem 3rem;
    max-width: 680px;
    min-width: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .article-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    flex: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.875rem;
    color: #999;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 0.25rem 0.6rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s, border-color 0.15s;
  }

  .edit-btn:hover { color: var(--accent); border-color: var(--accent); }

  /* Nút đọc bài gốc */
  .source-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: #fff;
    background: var(--accent);
    border-radius: 6px;
    padding: 0.4rem 0.85rem;
    margin-bottom: 1.25rem;
    transition: opacity 0.15s;
    font-weight: 500;
  }

  .source-btn:hover { opacity: 0.85; }

  /* ── Dialog popup — căn giữa màn hình ── */
  #topics-dialog {
    border: none;
    border-radius: 14px;
    padding: 0;
    width: min(320px, 88vw);
    max-height: 72vh;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,0.2);
    margin: auto;   /* browser tự căn giữa trong top-layer */
  }

  #topics-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(3px);
  }

  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.1rem 0.75rem;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: #fff;
  }

  .dialog-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
  }

  .dialog-close {
    background: none;
    border: none;
    font-size: 1rem;
    color: #aaa;
    cursor: pointer;
    padding: 0.1rem 0.3rem;
    line-height: 1;
    transition: color 0.15s;
  }

  .dialog-close:hover { color: var(--text); }

  .dialog-body {
    padding: 1rem 1.1rem;
    overflow-y: auto;
    max-height: calc(70vh - 56px);
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .page { display: block; }

    .hero-area { padding: 0 1.25rem 0.5rem; }

    .sidebar-area { display: none; }

    .article-area {
      border-top: 1px solid var(--border);
      padding: 1.25rem 1.25rem 3rem;
      max-width: 100%;
    }

    .article-title { font-size: 0.9375rem; }
  }
</style>
