---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBar from '../../components/StatusBar.astro';
import Hero from '../../components/Hero.astro';
import Sidebar from '../../components/Sidebar.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const REPO = 'Bangkts/bangkts.github.io';
const editUrl = `https://github.com/${REPO}/edit/main/src/content/articles/${entry.id}.md`;
---

<BaseLayout title={`${entry.data.title} — Bằng Nguyễn`}>
  <div class="page">

    <div class="hero-area">
      <StatusBar />
      <Hero />
    </div>

    <aside class="sidebar-area">
      <Sidebar currentSlug={entry.id} />
    </aside>

    <main class="article-area">
      <div class="title-row">
        <h1 class="article-title">{entry.data.title}</h1>
        <a href={editUrl} target="_blank" rel="noopener" class="edit-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Edit
        </a>
      </div>
      <!-- Nút link bài gốc (chỉ hiện khi có source) -->
      {entry.data.source && (
        <a
          href={entry.data.source}
          target="_blank"
          rel="noopener noreferrer"
          class="source-btn"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          Đọc bài gốc{entry.data.sourceLabel ? ` trên ${entry.data.sourceLabel}` : ''}
        </a>
      )}

      <div class="article-body">
        <Content />
      </div>
    </main>

  </div>

  <!-- Popup xác nhận xoá bài -->
  <dialog id="delete-dialog" class="del-dialog">
    <p class="del-heading">Xoá bài viết?</p>
    <p class="del-name" id="delete-title"></p>
    <p class="del-sub">Hành động này không thể hoàn tác.</p>

    <!-- Ô nhập token — chỉ hiện khi chưa có token -->
    <div id="token-section" class="token-section" style="display:none">
      <label class="token-label">GitHub Token</label>
      <input type="password" id="inline-token" class="token-input"
             placeholder="ghp_..." autocomplete="off" />
      <p class="token-hint">
        Lấy tại <a href="https://github.com/settings/tokens/new" target="_blank">github.com/settings/tokens</a>
        — tick <strong>repo</strong> + <strong>workflow</strong>
      </p>
    </div>

    <div id="delete-msg" class="del-msg"></div>
    <div class="del-btns">
      <button id="delete-cancel-btn"  class="del-btn del-btn-cancel">Huỷ</button>
      <button id="delete-confirm-btn" class="del-btn del-btn-confirm">Xoá</button>
    </div>
  </dialog>

  <!-- Popup chủ đề (dùng dialog — tự đóng khi bấm Escape) -->
  <dialog id="topics-dialog">
    <div class="dialog-header">
      <span class="dialog-title">Chủ đề</span>
      <button id="close-topics-btn" class="dialog-close" aria-label="Đóng">✕</button>
    </div>
    <div class="dialog-body">
      <Sidebar currentSlug={entry.id} />
    </div>
  </dialog>

<script>
  window.scrollTo({ top: 0, behavior: 'instant' });

  const dialog = document.getElementById('topics-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('open-topics-btn');
  const closeBtn = document.getElementById('close-topics-btn');

  openBtn?.addEventListener('click', () => dialog?.showModal());
  closeBtn?.addEventListener('click', () => dialog?.close());

  // Đóng khi click vùng backdrop
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // KHÔNG gọi dialog.close() khi click link —
  // trang static reload toàn bộ, dialog tự biến mất

  // ── Xoá bài viết ──────────────────────────────────────────
  const REPO = 'Bangkts/bangkts.github.io';

  // Popup xác nhận xoá
  const deleteDialog = document.getElementById('delete-dialog') as HTMLDialogElement | null;
  const deleteTitle  = document.getElementById('delete-title');
  const deleteCancelBtn  = document.getElementById('delete-cancel-btn');
  const deleteConfirmBtn = document.getElementById('delete-confirm-btn');
  const deleteMsg = document.getElementById('delete-msg');

  let pendingFile  = '';
  let pendingTitle = '';
  let pendingIsCurrent = false;

  const tokenSection = document.getElementById('token-section');
  const inlineToken  = document.getElementById('inline-token') as HTMLInputElement | null;

  // Gắn sự kiện cho tất cả nút ✕ trong sidebar
  document.querySelectorAll('.btn-delete').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const el = e.currentTarget as HTMLButtonElement;
      pendingFile      = el.dataset.file      || '';
      pendingTitle     = el.dataset.title     || 'bài viết này';
      pendingIsCurrent = el.dataset.isCurrent === 'true';

      if (deleteTitle) deleteTitle.textContent = pendingTitle;
      if (deleteMsg)   { deleteMsg.textContent = ''; deleteMsg.className = 'del-msg'; }

      // Hiện ô token nếu chưa có
      const hasToken = !!localStorage.getItem('ghToken');
      if (tokenSection) tokenSection.style.display = hasToken ? 'none' : 'block';
      if (inlineToken)  inlineToken.value = '';

      if (deleteDialog) deleteDialog.showModal();
    });
  });

  deleteCancelBtn?.addEventListener('click', () => deleteDialog?.close());
  deleteDialog?.addEventListener('click', (e) => {
    if (e.target === deleteDialog) deleteDialog.close();
  });

  deleteConfirmBtn?.addEventListener('click', async () => {
    // Ưu tiên: inline input → localStorage
    const typedToken = inlineToken?.value.trim() || '';
    const token = typedToken || localStorage.getItem('ghToken') || '';

    if (!token) {
      if (tokenSection) tokenSection.style.display = 'block';
      inlineToken?.focus();
      showDelMsg('⚠️ Vui lòng nhập GitHub Token bên trên.', 'warn');
      return;
    }

    // Lưu token vào localStorage để lần sau khỏi nhập lại
    if (typedToken) localStorage.setItem('ghToken', typedToken);

    if (deleteConfirmBtn) deleteConfirmBtn.disabled = true;
    showDelMsg('Đang xoá...', 'spin');

    try {
      // Bước 1: lấy SHA của file
      const infoRes = await fetch(
        `https://api.github.com/repos/${REPO}/contents/${pendingFile}`,
        { headers: { Authorization: `Bearer ${token}` } }
      );
      if (!infoRes.ok) throw new Error('Không tìm thấy file trên GitHub');
      const info = await infoRes.json();

      // Bước 2: xoá file
      const delRes = await fetch(
        `https://api.github.com/repos/${REPO}/contents/${pendingFile}`,
        {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: `feat: xoá bài "${pendingTitle}"`,
            sha: info.sha,
            branch: 'main',
          }),
        }
      );
      if (!delRes.ok) { const e = await delRes.json(); throw new Error(e.message); }

      // Bước 3: trigger deploy
      await fetch(
        `https://api.github.com/repos/${REPO}/actions/workflows/deploy.yml/dispatches`,
        {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', Accept: 'application/vnd.github+json' },
          body: JSON.stringify({ ref: 'main' }),
        }
      );

      showDelMsg('✅ Đã xoá! Trang sẽ cập nhật sau ~2 phút.', 'ok');

      // Nếu đang xem bài vừa xoá → về trang chủ sau 2 giây
      if (pendingIsCurrent) {
        setTimeout(() => { window.location.href = '/'; }, 2000);
      } else {
        // Reload trang sau 2 giây để sidebar cập nhật
        setTimeout(() => { window.location.reload(); }, 2000);
      }
    } catch (err: any) {
      showDelMsg(`✗ Lỗi: ${err.message}`, 'err');
      if (deleteConfirmBtn) deleteConfirmBtn.disabled = false;
    }
  });

  function showDelMsg(text: string, cls: string) {
    if (!deleteMsg) return;
    deleteMsg.textContent = text;
    deleteMsg.className   = `del-msg ${cls}`;
  }
</script>
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: 292px 1fr;
    grid-template-rows: auto 1fr;
    max-width: 960px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .hero-area {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
    padding: 0 2.5rem 0.5rem;
  }

  .sidebar-area {
    grid-column: 1 / 2;
    grid-row: 2 / 3;
    border-right: 1px solid var(--border);
    padding: 1.5rem 1rem 3rem 1.25rem;
    align-self: start;
    position: sticky;
    top: 0;
  }

  .article-area {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    border-top: 1px solid var(--border);
    padding: 1.5rem 2.5rem 3rem;
    max-width: 680px;
    min-width: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .article-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    flex: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.875rem;
    color: #999;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 0.25rem 0.6rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s, border-color 0.15s;
  }

  .edit-btn:hover { color: var(--accent); border-color: var(--accent); }

  /* ── Popup xác nhận xoá ── */
  .del-dialog {
    border: none;
    border-radius: 12px;
    padding: 1.5rem;
    width: min(340px, 88vw);
    box-shadow: 0 8px 32px rgba(0,0,0,0.16);
    margin: auto;
  }
  .del-dialog::backdrop { background: rgba(0,0,0,0.35); backdrop-filter: blur(2px); }
  .del-heading { font-size: 1rem; font-weight: 700; margin-bottom: .4rem; }
  .del-name    { font-size: .875rem; color: #444; margin-bottom: .3rem; font-style: italic; }
  .del-sub     { font-size: .8rem; color: #aaa; margin-bottom: 1rem; }
  .del-msg     { font-size: .8rem; min-height: 1.2rem; margin-bottom: .75rem; }
  .del-msg.ok   { color: #16a34a; }
  .del-msg.err  { color: #dc2626; }
  .del-msg.warn { color: #d97706; }
  .del-msg.spin { color: var(--accent); }
  .del-btns { display: flex; gap: .75rem; justify-content: flex-end; }
  .del-btn  { padding: .4rem 1rem; border-radius: 6px; font-size: .875rem; font-weight: 600; cursor: pointer; border: none; font-family: inherit; }
  .del-btn:disabled { opacity: .45; cursor: not-allowed; }
  .del-btn-cancel  { background: #f0f0f0; color: #333; }
  .del-btn-confirm { background: #dc2626; color: #fff; }
  .del-btn-cancel:hover  { background: #e0e0e0; }
  .del-btn-confirm:hover { background: #b91c1c; }

  /* Ô nhập token inline */
  .token-section { margin-bottom: .85rem; }
  .token-label   { display: block; font-size: .75rem; font-weight: 600; color: #555; margin-bottom: .3rem; }
  .token-input   {
    width: 100%; padding: .4rem .6rem; border: 1px solid #ddd; border-radius: 6px;
    font-size: .8125rem; font-family: inherit; outline: none;
  }
  .token-input:focus { border-color: var(--accent); }
  .token-hint    { font-size: .72rem; color: #aaa; margin-top: .3rem; }
  .token-hint a  { color: var(--accent); }

  /* Nút đọc bài gốc */
  .source-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: #fff;
    background: var(--accent);
    border-radius: 6px;
    padding: 0.4rem 0.85rem;
    margin-bottom: 1.25rem;
    transition: opacity 0.15s;
    font-weight: 500;
  }

  .source-btn:hover { opacity: 0.85; }

  /* ── Dialog popup — căn giữa màn hình ── */
  #topics-dialog {
    border: none;
    border-radius: 14px;
    padding: 0;
    width: min(320px, 88vw);
    max-height: 72vh;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,0.2);
    margin: auto;   /* browser tự căn giữa trong top-layer */
  }

  #topics-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(3px);
  }

  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.1rem 0.75rem;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: #fff;
  }

  .dialog-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
  }

  .dialog-close {
    background: none;
    border: none;
    font-size: 1rem;
    color: #aaa;
    cursor: pointer;
    padding: 0.1rem 0.3rem;
    line-height: 1;
    transition: color 0.15s;
  }

  .dialog-close:hover { color: var(--text); }

  .dialog-body {
    padding: 1rem 1.1rem;
    overflow-y: auto;
    max-height: calc(70vh - 56px);
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .page { display: block; }

    .hero-area { padding: 0 1.25rem 0.5rem; }

    .sidebar-area { display: none; }

    .article-area {
      border-top: 1px solid var(--border);
      padding: 1.25rem 1.25rem 3rem;
      max-width: 100%;
    }

    .article-title { font-size: 0.9375rem; }
  }
</style>
