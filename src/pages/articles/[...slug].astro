---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBar from '../../components/StatusBar.astro';
import Hero from '../../components/Hero.astro';
import Sidebar from '../../components/Sidebar.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const REPO = 'Bangkts/bangkts.github.io';
const editUrl = `https://github.com/${REPO}/edit/main/src/content/articles/${entry.id}.md`;
---

<BaseLayout title={`${entry.data.title} — Bằng Nguyễn`}>
  <div class="page">

    <!-- Cột phải hàng 1: status bar + hero (desktop) -->
    <div class="hero-area">
      <StatusBar />
      <Hero />
    </div>

    <!-- Cột trái hàng 2: sidebar (desktop) -->
    <aside class="sidebar-area">
      <Sidebar currentSlug={entry.id} />
    </aside>

    <!-- Cột phải hàng 2: bài viết -->
    <main class="article-area">

      <!-- Mobile only: sidebar thu gọn dạng dropdown -->
      <details class="mobile-nav">
        <summary>
          <span class="mobile-nav-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            Chủ đề
          </span>
          <span class="mobile-nav-current">{entry.data.title}</span>
        </summary>
        <div class="mobile-nav-body">
          <Sidebar currentSlug={entry.id} />
        </div>
      </details>

      <div class="title-row">
        <h1 class="article-title">{entry.data.title}</h1>
        <a href={editUrl} target="_blank" rel="noopener" class="edit-btn" title="Chỉnh sửa bài viết">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Edit
        </a>
      </div>

      <div class="article-body">
        <Content />
      </div>
    </main>

  </div>
</BaseLayout>

<style>
  /* ── DESKTOP layout (grid 2 cột) ── */
  .page {
    display: grid;
    grid-template-columns: 195px 1fr;
    grid-template-rows: auto 1fr;
    max-width: 960px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .hero-area {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
    padding: 0 2.5rem 0.5rem;
  }

  .sidebar-area {
    grid-column: 1 / 2;
    grid-row: 2 / 3;
    border-right: 1px solid var(--border);
    padding: 1.5rem 1rem 3rem 1.25rem;
    align-self: start;
    position: sticky;
    top: 0;
  }

  .article-area {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    border-top: 1px solid var(--border);
    padding: 1.5rem 2.5rem 3rem;
    max-width: 680px;
    min-width: 0;
  }

  /* Mobile nav ẩn trên desktop */
  .mobile-nav { display: none; }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .article-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    flex: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.875rem;
    color: #999;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 0.25rem 0.6rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s, border-color 0.15s;
  }

  .edit-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── MOBILE (< 768px) ── */
  @media (max-width: 768px) {
    .page {
      display: block;       /* bỏ grid, về 1 cột */
    }

    .hero-area {
      padding: 0 1.25rem 0.5rem;
    }

    /* Ẩn sidebar desktop */
    .sidebar-area {
      display: none;
    }

    .article-area {
      border-top: 1px solid var(--border);
      padding: 1.25rem 1.25rem 3rem;
      max-width: 100%;
    }

    /* Hiện mobile nav dropdown */
    .mobile-nav {
      display: block;
      margin-bottom: 1.25rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }

    .mobile-nav summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      cursor: pointer;
      user-select: none;
      list-style: none;
      background: #fafafa;
    }

    .mobile-nav summary::-webkit-details-marker { display: none; }

    .mobile-nav-label {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text);
      flex-shrink: 0;
    }

    .mobile-nav-current {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
      text-align: right;
    }

    .mobile-nav[open] summary {
      border-bottom: 1px solid var(--border);
    }

    .mobile-nav-body {
      padding: 1rem 1rem 0.5rem;
    }

    .article-title {
      font-size: 0.9375rem;
    }
  }
</style>
